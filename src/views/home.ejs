<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <div class="home-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Catalog</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
        <% } %>
      </ul>
    </div>

    <div class="home-animation"></div>

    <div class="home-hero">
      <div class="home-brand-title">Yasmin</div>
      <div class="home-brand-sub">Cosmetics &middot; Admin</div>
      <p class="home-tagline">
        <% if(!member) { %>
        Sign in to manage your catalog, orders, and members.
        <% } else { %>
        Welcome back, <%= member.memberNick %>.
        <% } %>
      </p>

      <div class="home-auth-card">
        <% if(!member) { %>
        <a href="/admin/login" class="home-btn home-btn-primary">Log in</a>
        <a href="/admin/signup" class="home-btn home-btn-ghost">Create an account</a>
        <% } else { %>
        <a href="/admin/product/all" class="home-btn home-btn-primary">Go to Catalog</a>
        <a href="/admin/user/all" class="home-btn home-btn-ghost">View Users</a>
        <% } %>
      </div>

      <div class="home-foot-hint">YASMIN COSMETICS &middot; STORE ADMINISTRATION</div>
    </div>
  </div>

  <script type="module" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
