<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/admin.css" />
<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <% if(!member) { %>
  <div class="admin-guest">
    <div class="admin-guest-card">
      <span>Please login first!</span>
      <a href="/admin/login">Go to Login</a>
    </div>
  </div>
  <% } else { %>
  <div class="admin-shell">
    <%- include('includes/admin-sidebar', { active: 'users' }) %>

    <div class="admin-main">
      <%- include('includes/admin-topbar') %>

      <main class="admin-content">
        <div class="admin-card">
          <div class="admin-card-header">
            <h1 class="admin-card-title">Users List</h1>
            <input type="text" class="user-search" placeholder="Search user..." />
          </div>

          <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Name</th>
                  <th>Phone</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% users.map(function(value, index) { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td class="cell-strong user-name-cell"><%= value.memberNick %></td>
                  <td class="user-phone-cell"><%= value.memberPhone %></td>
                  <td>
                    <select
                      class="status-select member-status status-<%= value.memberStatus %>"
                      id="<%= value._id %>"
                    >
                      <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                      <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
                      <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
  <% } %>
</body>

<script type="text/javascript" src="/js/users.js"></script>

<%- include('includes/footer') %>
