<header class="admin-topbar">
  <button type="button" class="admin-sidebar-toggle" aria-label="Toggle sidebar">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
  </button>

  <div class="admin-topbar-right">
    <button type="button" class="admin-icon-btn" aria-label="Notifications">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
      </svg>
    </button>

    <div class="admin-profile">
      <img
        src="<%= member && member.memberImage ? '/' + member.memberImage : '/img/default.jpeg' %>"
        alt="<%= member ? member.memberNick : 'Admin' %>"
      />
      <span><%= member ? member.memberNick : 'Admin' %></span>
    </div>
  </div>
</header>
